{
  "name": "standard_rf_test",
  "description": "Random Forest Classifier on Masterlist V6 features",
  "tags": [
    "random_forest",
    "sklearn",
    "masterlist_v6"
  ],
  "model_type": "sklearn",
  "model_name": "random_forest",
  "model_params": {
    "n_estimators": 200,
    "random_state": 42
  },
  "dataset_name": "masterlist_v6",
  "data_dir": "../data/masterlist_v6",
  "csv_file": "masterlist_v6_full_features.csv",
  "feature_cols": [
    "mean_l",
    "mean_a",
    "mean_b",
    "mean_chroma",
    "median_l",
    "median_a",
    "median_b",
    "median_chroma",
    "percentile25_l",
    "percentile25_a",
    "percentile25_b",
    "percentile25_chroma",
    "percentile75_l",
    "percentile75_a",
    "percentile75_b",
    "percentile75_chroma"
  ],
  "label_cols": [
    "Base",
    "Primary",
    "Secondary"
  ],
  "train_split": 0.8,
  "random_seed": 42,
  "loss_function": "CrossEntropyLoss",
  "loss_weights": [
    1.0,
    1.0,
    1.0
  ],
  "eval_metrics": [
    "base_acc",
    "tol_base_acc",
    "primary_acc",
    "secondary_acc",
    "Hierarchical Score",
    "Exact Match",
    "Base-Primary Exact Match"
  ],
  "evaluator_params": {
    "eos_token": -1,
    "weights": [
      0.3,
      0.1
    ],
    "tol_base": 4
  },
  "save_dir": "../experiments",
  "save_model": true,
  "save_predictions": true,
  "save_history": true,
  "device": "auto",
  "num_workers": 0
}