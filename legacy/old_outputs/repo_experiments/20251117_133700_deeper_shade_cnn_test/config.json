{
  "name": "deeper_shade_cnn_test",
  "description": "Test current DeeperShadeCNN model on masterlist_v6 dataset w/ augmentations",
  "tags": [
    "pytorch",
    "deeper_shade_cnn",
    "augmented",
    "test"
  ],
  "model_type": "pytorch",
  "model_name": "deeper_shade_cnn",
  "model_params": {
    "num_classes": [
      12,
      11,
      11
    ]
  },
  "dataset_name": "masterlist_v6",
  "data_dir": "data/masterlist_v6",
  "csv_file": "masterlist_v6_full_features.csv",
  "label_cols": [
    "Base",
    "Primary",
    "Secondary"
  ],
  "train_split": 0.8,
  "random_seed": 42,
  "batch_size": 32,
  "num_epochs": 500,
  "learning_rate": 0.001,
  "optimizer": "Adam",
  "optimizer_params": {
    "weight_decay": 0.0001
  },
  "scheduler": null,
  "scheduler_params": {},
  "early_stopping_patience": 10,
  "loss_function": "multitask_crossentropy",
  "loss_weights": [
    0.3,
    1.0,
    0.9
  ],
  "eval_metrics": [
    "base_acc",
    "tol_base_acc",
    "primary_acc",
    "secondary_acc",
    "Hierarchical Score",
    "Exact Match",
    "Base-Primary Exact Match",
    "Primary-Secondary Exact Match"
  ],
  "evaluator_params": {
    "eos_token": -1,
    "weights": [
      0.5,
      0.3
    ],
    "tol_base": 4
  },
  "save_dir": "experiments",
  "save_model": true,
  "save_predictions": true,
  "save_history": true,
  "use_transform_preset": false,
  "transform_preset": "imagenet",
  "image_size": [
    224,
    224
  ],
  "normalize": true,
  "normalize_mean": [
    0.485,
    0.456,
    0.406
  ],
  "normalize_std": [
    0.229,
    0.224,
    0.225
  ],
  "augmentation": {
    "random_horizontal_flip": true,
    "random_vertical_flip": true,
    "random_rotation": true,
    "rotation_degrees": 90,
    "random_crop": false,
    "random_resized_crop": true,
    "scale": [
      0.8,
      1.0
    ],
    "ratio": [
      0.9,
      1.1
    ],
    "gaussian_blur": true,
    "blur_kernel_size": 5,
    "blur_sigma": [
      0.1,
      2.0
    ]
  },
  "device": "auto",
  "num_workers": 0
}