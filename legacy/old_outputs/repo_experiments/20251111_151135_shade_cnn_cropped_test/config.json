{
  "name": "shade_cnn_cropped_test",
  "description": "Test current ShadeCNN model on masterlist_v6 dataset with cropped images",
  "tags": [
    "pytorch",
    "shade_cnn",
    "augmented",
    "test"
  ],
  "model_type": "pytorch",
  "model_name": "shade_cnn",
  "model_params": {
    "num_classes": [
      12,
      11,
      11
    ]
  },
  "dataset_name": "masterlist_v6",
  "data_dir": "data/masterlist_v6",
  "csv_file": "masterlist_v6_full_features.csv",
  "label_cols": [
    "Base",
    "Primary",
    "Secondary"
  ],
  "train_split": 0.8,
  "random_seed": 42,
  "batch_size": 32,
  "num_epochs": 500,
  "learning_rate": 0.001,
  "optimizer": "Adam",
  "optimizer_params": {},
  "scheduler": null,
  "scheduler_params": {},
  "early_stopping_patience": 10,
  "loss_function": "multitask_crossentropy",
  "loss_weights": [
    1.0,
    0.5,
    0.3
  ],
  "eval_metrics": [
    "base_acc",
    "tol_base_acc",
    "primary_acc",
    "secondary_acc",
    "Hierarchical Score",
    "Exact Match",
    "Base-Primary Exact Match"
  ],
  "evaluator_params": {
    "eos_token": -1,
    "weights": [
      0.5,
      0.3
    ],
    "tol_base": 4
  },
  "save_dir": "experiments",
  "save_model": true,
  "save_predictions": true,
  "save_history": true,
  "use_transform_preset": false,
  "transform_preset": "imagenet",
  "image_size": [
    224,
    224
  ],
  "normalize": true,
  "normalize_mean": [
    0.485,
    0.456,
    0.406
  ],
  "normalize_std": [
    0.229,
    0.224,
    0.225
  ],
  "augmentation": {
    "random_horizontal_flip": false,
    "random_rotation": false,
    "color_jitter": false,
    "random_crop": true,
    "crop_size": [
      200,
      200
    ]
  },
  "device": "auto",
  "num_workers": 0
}